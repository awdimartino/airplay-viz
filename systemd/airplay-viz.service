[Unit]
Description=AirPlay now-playing screen (album art + equalizer) on HDMI
After=sound.target shairport-sync.service
Wants=shairport-sync.service
Conflicts=getty@tty1.service cava-hdmi.service
StartLimitIntervalSec=0

[Service]
User=argyle
SupplementaryGroups=video render input
Environment=SDL_VIDEODRIVER=kmsdrm PYGAME_HIDE_SUPPORT_PROMPT=1
# Name shown on the idle screen (match shairport-sync's general.name)
Environment="AIRPLAY_VIZ_NAME=Alex Pi"
# Settings page port (http://<host>:8091/); 0 disables it
#Environment=AIRPLAY_VIZ_PORT=8091
# Optional music-reactive iStrip+ lamp (Bluetooth MAC); remove to disable.
# Its behaviour/colour settings are on the settings page.
# AIRPLAY_VIZ_LAMP_RELEASE: seconds after playback to disconnect (0 = stay connected).
Environment=AIRPLAY_VIZ_LAMP=B7:C2:85:5D:70:54
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStartPre=+/bin/sh -c "chvt 1; setterm --blank 0 --powerdown 0 --cursor off > /dev/tty1 < /dev/tty1"
# Drop any stale BLE link to the lamp left by a killed process (a connected
# lamp stops advertising, so it could not be found again)
ExecStartPre=-+/bin/sh -c '[ -z "$AIRPLAY_VIZ_LAMP" ] || timeout 5 btmgmt disconnect -t 1 "$AIRPLAY_VIZ_LAMP"'
ExecStopPost=-+/bin/sh -c '[ -z "$AIRPLAY_VIZ_LAMP" ] || timeout 5 btmgmt disconnect -t 1 "$AIRPLAY_VIZ_LAMP"'
ExecStart=/usr/bin/python3 -u /home/argyle/airplay-viz/airplay-viz.py
Restart=always
RestartSec=3
# stop signal to python only, so it can switch the lamp off and shut cava down
# itself
KillMode=mixed

[Install]
WantedBy=multi-user.target

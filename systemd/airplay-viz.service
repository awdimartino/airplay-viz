[Unit]
Description=AirPlay now-playing screen (album art + equalizer) on HDMI
After=sound.target shairport-sync.service
Wants=shairport-sync.service
Conflicts=getty@tty1.service cava-hdmi.service
StartLimitIntervalSec=0

[Service]
User=argyle
SupplementaryGroups=video render input
Environment=SDL_VIDEODRIVER=kmsdrm PYGAME_HIDE_SUPPORT_PROMPT=1
# Name shown on the idle screen (match shairport-sync's general.name)
Environment="AIRPLAY_VIZ_NAME=Alex Pi"
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStartPre=+/bin/sh -c "chvt 1; setterm --blank 0 --powerdown 0 --cursor off > /dev/tty1 < /dev/tty1"
ExecStart=/usr/bin/python3 -u /home/argyle/airplay-viz/airplay-viz.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
